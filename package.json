{
  "name": "dsh-desktop",
  "version": "0.2.0",
  "description": "Monorepo: framework-agnostic desktop shell protocol + Electron implementation + dsh desktop plugins.",
  "private": true,
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "start": "npm run start --workspace app",
    "dev": "npm run dev --workspace app",
    "package:dir": "npm run package:dir --workspace app",
    "build": "npm run build --workspace app",
    "test": "npm run test --workspace app"
  }
}
